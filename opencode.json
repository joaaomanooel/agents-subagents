{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "model": "llama.cpp/LiquidAI/LFM2.5-350M-GGUF",
  "subagent_depth": 2,
  "agent": {
    "staff-orchestrator": {
      "mode": "all",
      "subagent_depth": 2,
      "permission": {
        "task": {
          "*": "allow",
          "implementation-planner": "allow",
          "senior-plan-specialist": "allow",
          "senior-backend-developer": "allow",
          "senior-frontend-developer": "allow",
          "senior-fullstack-developer": "allow",
          "senior-typescript-specialist": "allow",
          "senior-test-engineer": "allow",
          "unified-code-reviewer": "allow",
          "docs-context-agent": "allow",
          "engineering-writer": "allow",
          "database-specialist": "allow",
          "api-designer": "allow",
          "security-auditor": "allow",
          "performance-analyst": "allow",
          "tech-debt-hunter": "allow",
          "feature-team-pilot": "allow",
          "code-review-team-lead": "allow",
          "bug-squad-lead": "allow",
          "refactoring-team-lead": "allow",
          "haiku-team": "allow",
          "multidisciplinary-board": "allow"
        }
      }
    },
    "feature-team-pilot": {
      "mode": "all",
      "subagent_depth": 2,
      "permission": {
        "task": {
          "*": "allow",
          "implementation-planner": "allow",
          "api-designer": "allow",
          "senior-backend-developer": "allow",
          "database-specialist": "allow",
          "senior-frontend-developer": "allow",
          "senior-typescript-specialist": "allow",
          "senior-test-engineer": "allow",
          "unified-code-reviewer": "allow",
          "security-auditor": "allow",
          "performance-analyst": "allow",
          "docs-context-agent": "allow",
          "engineering-writer": "allow"
        }
      }
    },
    "code-review-team-lead": {
      "mode": "all",
      "subagent_depth": 2,
      "permission": {
        "task": {
          "*": "allow",
          "unified-code-reviewer": "allow",
          "security-auditor": "allow",
          "performance-analyst": "allow",
          "senior-typescript-specialist": "allow",
          "api-designer": "allow",
          "senior-test-engineer": "allow"
        }
      }
    },
    "bug-squad-lead": {
      "mode": "all",
      "subagent_depth": 2,
      "permission": {
        "task": {
          "*": "allow",
          "senior-test-engineer": "allow",
          "senior-fullstack-developer": "allow",
          "senior-backend-developer": "allow",
          "senior-frontend-developer": "allow",
          "database-specialist": "allow",
          "senior-typescript-specialist": "allow",
          "security-auditor": "allow",
          "performance-analyst": "allow",
          "api-designer": "allow",
          "unified-code-reviewer": "allow"
        }
      }
    },
    "refactoring-team-lead": {
      "mode": "all",
      "subagent_depth": 2,
      "permission": {
        "task": {
          "*": "allow",
          "senior-typescript-specialist": "allow",
          "performance-analyst": "allow",
          "api-designer": "allow",
          "tech-debt-hunter": "allow",
          "senior-plan-specialist": "allow",
          "senior-fullstack-developer": "allow",
          "senior-test-engineer": "allow",
          "unified-code-reviewer": "allow",
          "docs-context-agent": "allow"
        }
      }
    }
  },
  "autoupdate": true,
  "instructions": [
    "rules/*.md",
    "CLAUDE.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "**/.DS_Store"
    ]
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-x64",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    },
    "agent-skills": {
      "command": ["npx", "-y", "@tech-leads-club/agent-skills-mcp@latest"],
      "enabled": true,
      "type": "local"
    }
  }
}

