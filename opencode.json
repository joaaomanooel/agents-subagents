{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": "ask"
  },
  "autoupdate": true,
  "instructions": [
    "rules/*.md",
    "CLAUDE.md"
  ],
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      ".git/**",
      "**/.DS_Store"
    ]
  },
  "mcp": {
    "pencil": {
      "command": [
        "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-x64",
        "--app",
        "desktop"
      ],
      "enabled": true,
      "type": "local"
    },
    "agent-skills": {
      "command": ["npx", "-y", "@tech-leads-club/agent-skills-mcp@latest"],
      "enabled": true,
      "type": "local"
    }
  }
}
